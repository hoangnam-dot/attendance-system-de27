# Database configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=change_me_to_your_db_password
DB_ROOT_PASSWORD=change_me_to_your_root_password

# Application configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=change_me_to_a_secure_random_jwt_secret
TZ=Asia/Ho_Chi_Minh

# External Ports
APP_EXTERNAL_PORT=80
PMA_EXTERNAL_PORT=8080
PROMETHEUS_EXTERNAL_PORT=9090
GRAFANA_EXTERNAL_PORT=3001

# Monitoring configuration (Phase 2)
MYSQL_EXPORTER_PASSWORD=change_me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_your_grafana_password
